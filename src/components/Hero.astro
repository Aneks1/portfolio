---
import Navbar from './Navbar.astro';
const { links = [] } = Astro.props;
---

<section class="hero" id="home">
  <Navbar links={links} />
  <div class="hero-inner">
    <h1 class="hero-title">
      <span>Yo!</span>
      <span class="hero-title-small">I am</span>
      <span>Gonzalo Ames,</span>
      <span class="hero-title-small">aka </span>
      <span class="aka" aria-label="Aneks">Aneks</span>
    </h1>
    <p class="hero-subtitle">
      A developer building web systems, tools, and bots - and a composer creating original music.
    </p>
    <div class="hero-cta">
      <a class="cta main" href="#projects">
        <span class="cta-label">View projects</span>
      </a>
      <a class="cta ghost" href="#services">Hire me</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    width: 100%;
    padding: clamp(2rem, 6vw, 4rem) clamp(1.5rem, 6vw, 5rem) clamp(3rem, 8vw, 5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: #f9f9ff;
    overflow: hidden;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: clamp(1.5rem, 3vw, 1.75rem);
    width: min(900px, 100%);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(3.2rem, 8vw, 5rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-shadow: 0 0 10px rgba(255, 255, 255, 0.25);
  }

  .hero-title-small {
    font-size: 0.75em;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-left: 0.35rem;
  }

  .aka {
    position: relative;
    display: inline-block;
    background-image: linear-gradient(
      to right,
      var(--main-color-1),
      var(--main-color-2),
      var(--main-color-1)
    );
    background-size: 300% 100%;
    animation: gradient 2.4s linear infinite;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
  }

  .aka::before {
    content: attr(aria-label);
    position: absolute;
    inset: 0;
    background: inherit;
    background-size: inherit;
    animation: gradient 2.4s linear infinite;
    filter: blur(12px);
    opacity: 0.5;
    z-index: -1;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-subtitle {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.35;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.9rem 1.9rem;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: rgba(255, 255, 255, 0.85);
    transition: transform 0.2s ease, border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
  }

  .cta.main {
    background-image: linear-gradient(to right, var(--main-color-1), var(--main-color-2));
    border: 2px;
    color: #05050b;
    position: relative;
  }

  .cta.main::before {
    content: "";
    position: absolute;
    height: 100%;
    width: 100%;
    background-image: linear-gradient(to right, var(--main-color-1), var(--main-color-2));
    z-index: -1;
    border-radius: 999px;
    filter: blur(10px);
    opacity: 0.5;
  }

  .cta.main:hover,
  .cta.main:focus-visible {
    transform: translateY(-2px);
  }

  .cta.ghost {
    backdrop-filter: blur(4px);
  }

  .cta.ghost:hover,
  .cta.ghost:focus-visible {
    color: #fff;
    border-color: #fff;
    transform: translateY(-2px);
  }

  .cta:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.4);
    outline-offset: 4px;
  }

  @keyframes gradient {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 200% 50%;
    }
  }

  @media (max-width: 700px) {
    .hero {
      min-height: auto;
      padding-top: clamp(5rem, 18vw, 7rem);
      padding-bottom: clamp(2.5rem, 10vw, 4rem);
      gap: 1.5rem;
    }

    .hero-inner {
      align-items: center;
      text-align: center;
    }

    .hero-title {
      font-size: clamp(2.4rem, 10vw, 3.5rem);
      line-height: 1.15;
    }

    .hero-title-line,
    .hero-title-line-accent {
      width: 100%;
    }

    .hero-title-small {
      display: inline-block;
      margin-left: 0.25rem;
    }

    .hero-cta {
      justify-content: center;
      width: 100%;
    }

    .cta {
      width: 100%;
    }
  }
</style>
