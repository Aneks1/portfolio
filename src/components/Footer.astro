---
const { copyright, links = [] } = Astro.props;
---

<footer class="footer">
  <span>{copyright}</span>
  {links.length > 0 && (
    <ul class="footer-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
  )}
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    color: #b7b2d7;
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-links a:focus {
    color: #e7e3ff;
  }
</style>
