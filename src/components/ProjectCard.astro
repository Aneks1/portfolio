---
const {
  title,
  description,
  tags = [],
  links = [],
} = Astro.props;
---

<article class="project-card">
  <header>
    <h3>{title}</h3>
    <ul class="tags">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </header>
  <p>{description}</p>
  <footer>
    {links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>
    ))}
  </footer>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem;
    border-radius: 18px;
    background: rgba(19, 21, 34, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #f6f5ff;
  }

  header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags li {
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: rgba(127, 90, 240, 0.15);
    color: #d2c8ff;
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  p {
    margin: 0;
    color: #d9d7ef;
  }

  footer {
    display: flex;
    gap: 1rem;
  }

  footer a {
    color: #8de0f4;
    text-decoration: none;
    font-weight: 500;
  }

  footer a:hover,
  footer a:focus {
    text-decoration: underline;
  }
</style>
